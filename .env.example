APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona waktu aplikasi. Wajib diisi: bawaan Laravel adalah UTC,
# yang membuat seluruh created_at telemetri 7 jam di belakang WIB.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_monitoring_asv
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
# REVERB_SERVER_PORT = port yang di-bind server, REVERB_PORT = port yang dipakai
# browser. Keduanya harus sama. Pastikan portnya belum dipakai servis lain.
REVERB_SERVER_PORT=8081
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# Stream kamera kapal (MJPEG dari Raspberry Pi)
# ---------------------------------------------------------------------------
# Dashboard HANYA menampilkan stream ini. Jangan pernah memakai kamera
# perangkat operator - yang ditonton adalah kamera kapal.
#
# PENTING: di Linux satu /dev/videoN hanya bisa dibuka SATU proses. Karena
# program deteksi OpenCV sudah memegang kameranya, program itu juga yang
# harus menyiarkan frame-nya. Jangan jalankan mjpg-streamer terpisah untuk
# perangkat yang sama - keduanya akan berebut dan salah satu gagal.
#
# Contoh penyiar lengkap, catatan fps, dan soal CORS ada di:
#   docs/kamera-raspberry-pi.md
#
# Kosongkan kalau belum siap - dashboard akan menampilkan placeholder.
CAMERA_ATAS_URL=
CAMERA_BAWAH_URL=

# Token untuk POST /api/telemetry dari program Python di kapal.
# Endpoint ini terbuka lewat ngrok - kosong berarti SEMUA permintaan ditolak.
# Buat dengan: php -r "echo bin2hex(random_bytes(24));"
ASV_INGEST_TOKEN=

# Folder foto misi yang diisi program Python (mission_controller.py).
# Di Raspberry Pi biasanya /home/pi/asv/mission_images
ASV_MISSION_IMAGES_PATH=
